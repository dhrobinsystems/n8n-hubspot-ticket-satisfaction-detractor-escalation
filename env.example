# =============================================================================
# n8n-hubspot-ticket-satisfaction-detractor-escalation — environment template
# Set these on the n8n host/container (read through $env). Never commit real values.
# Values that still start with YOUR_ are treated as "not set".
# License: MIT © 2026 dhRobin Systems · Provided as-is, see the disclaimer.
# =============================================================================

# --- Safety -------------------------------------------------------------------
# true = verify, evaluate and plan everything, but change nothing in HubSpot and send no alerts.
# Anything other than an explicit "false" keeps it on.
DRY_RUN=true
# true = HubSpot must report a SANDBOX or DEVELOPER_TEST portal, or the run stops before any write.
SANDBOX_MODE=true

# --- HubSpot --------------------------------------------------------------------
# Private App access token. Scopes: crm.objects.tickets.read, crm.objects.tickets.write,
# crm.objects.owners.read (or the legacy "tickets" scope instead of the two ticket scopes).
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
HUBSPOT_API_BASE=https://api.hubapi.com

# --- Webhook signature (HMAC-SHA256) ---------------------------------------------
# Shared secret used by your survey tool to sign each request (min 16 chars; e.g. `openssl rand -hex 32`).
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
# Optional: the previous secret, accepted during a rotation window.
WEBHOOK_SECRET_PREVIOUS=
# Header carrying "sha256=<hex>" (bare hex or base64 also accepted).
SIGNATURE_HEADER=x-signature-256
# Header carrying the Unix timestamp (seconds or ms) used in the signed message.
SIGNATURE_TIMESTAMP_HEADER=x-signature-timestamp
# timestamp.body = HMAC over "<timestamp>.<raw body>" (recommended) · body = HMAC over the raw body only
SIGNATURE_PAYLOAD_FORMAT=timestamp.body
# Reject requests whose timestamp is further than this from now (replay protection).
SIGNATURE_TOLERANCE_SECONDS=300
MAX_RESPONSES_PER_REQUEST=25
# Ignore re-deliveries of the same response_id for this many hours (0 = off). Live runs only.
DEDUPE_HOURS=72

# --- Detractor thresholds --------------------------------------------------------
# CSAT: detractor when score < CSAT_DETRACTOR_THRESHOLD; critical when score <= CSAT_CRITICAL_THRESHOLD.
CSAT_SCALE_MAX=5
CSAT_DETRACTOR_THRESHOLD=3
CSAT_CRITICAL_THRESHOLD=1
# NPS (0-10): detractor when score <= NPS_DETRACTOR_MAX; critical when <= NPS_CRITICAL_MAX.
NPS_DETRACTOR_MAX=6
NPS_CRITICAL_MAX=3
# NES (-100..100, or -1..1 scaled): detractor when score < NES_DETRACTOR_THRESHOLD (negative); critical when <= NES_CRITICAL_THRESHOLD.
NES_DETRACTOR_THRESHOLD=0
NES_CRITICAL_THRESHOLD=-50
# A detractor whose feedback contains any of these words is treated as critical.
CRITICAL_KEYWORDS=cancel,churn,refund,lawyer,legal action,terminate

# --- Ticket handling --------------------------------------------------------------
# When only contact_id is sent, use the contact's most recently modified ticket within this many days.
LOOKUP_WINDOW_DAYS=90
REOPEN_CLOSED_TICKETS=true
# Closed tickets older than this are escalated and noted, but not re-opened.
REOPEN_MAX_AGE_DAYS=30
# Optional exact re-open stage per pipeline, e.g. {"0":"3"} (pipeline ID → stage ID).
REOPEN_STAGE_MAP_JSON=
# Otherwise: first open stage whose label matches this regex, else the first open stage.
REOPEN_STAGE_LABEL_REGEX=waiting on us|waiting on support|in progress|open
# Optional extra stage IDs to treat as closed (on top of HubSpot's ticketState=CLOSED).
CLOSED_STAGE_IDS=
# Priority for detractors / critical detractors (LOW, MEDIUM, HIGH, URGENT). Never lowered.
ESCALATION_PRIORITY=HIGH
CRITICAL_PRIORITY=HIGH
# Optional HubSpot-user (owner) ticket property that holds the account manager, e.g. account_manager_owner.
ACCOUNT_MANAGER_PROPERTY=
NOTE_FEEDBACK_MAX_CHARS=3000

# --- Alerts ------------------------------------------------------------------------
# slack | pagerduty | slack,pagerduty
ALERT_DESTINATIONS=slack
# One or more Slack incoming webhook URLs (comma-separated, max 10), e.g. an #exec-escalations channel.
SLACK_WEBHOOK_URLS=YOUR_SLACK_WEBHOOK_URL
# PagerDuty Events API v2 integration ("routing") key.
PAGERDUTY_ROUTING_KEY=YOUR_PAGERDUTY_ROUTING_KEY
# critical = page only critical detractors · high = page every detractor
PAGERDUTY_MIN_SEVERITY=critical
# Map HubSpot owner IDs or owner emails to Slack user IDs for @mentions.
# SLACK_USER_MAP_JSON={"10000001":"U0000000001","owner_1@example.com":"U0000000002"}
SLACK_USER_MAP_JSON=
# Slack user (U…) or user-group (S…) IDs mentioned on critical detractors.
EXEC_SLACK_MENTIONS=
# false = customer emails are shown masked (c***@example.com) and never stored unmasked in item data.
SHOW_CUSTOMER_EMAIL=false
# Optional Slack-compatible webhook for masked error alerts (ops channel).
ALERT_WEBHOOK_URL=YOUR_ALERT_WEBHOOK_URL

# --- Manual test ------------------------------------------------------------------
# Ticket ID used by the Manual Trigger's signed sample request (fictional by default).
SAMPLE_TICKET_ID=1000000001

# --- n8n instance (set on the host, not in the workflow) ----------------------------
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# WEBHOOK_URL=https://n8n.example.com/
